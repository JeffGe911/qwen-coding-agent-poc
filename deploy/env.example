# Copy to deploy/.env on a Linux GPU server. Never commit the actual key.
# Use only a hex token to avoid Nginx template quoting ambiguity.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
LOCAL_MODEL_API_KEY=REPLACE_WITH_RANDOM_HEX_TOKEN
MODEL_DIR=/srv/models/Qwen2.5-Coder-1.5B-Instruct
TP_SIZE=1
