# Migration comparison (deploy/backends/vllm-qwen7b-awq.json): 7B AWQ at context 8192, like ollama-r2.
# Copy to deploy/linux-vllm/.env (git-ignored) and fill in. The key never goes into Git, screenshots or evidence.
# Generate a key: python3 -c "import secrets; print(secrets.token_hex(32))"
VLLM_API_KEY=REPLACE_WITH_64_HEX_CHARS

# Weights downloaded by deploy/linux-vllm/download_model.sh (pinned revision).
# First test, small model: Qwen/Qwen2.5-Coder-1.5B-Instruct @ 2e1fd397ee46e1388853d2af2c993145b0f1098a (BF16 safetensors, 3.1 GB)
# Second step:             Qwen/Qwen2.5-Coder-7B-Instruct-AWQ @ 8e8ed243bbe6f9a5aff549a0924562fc719b2b8a (AWQ 4-bit, 5.6 GB)
# Neither is the Ollama GGUF (qwen2.5-coder:7b Q4_K_M); results are compared with that difference stated.
MODEL_DIR=/srv/models/Qwen2.5-Coder-7B-Instruct-AWQ
SERVED_MODEL_NAME=qwen-local

# Serving limits (the acceptance script reads them back from the running server).
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=4
GPU_MEMORY_UTILIZATION=0.70
HOST_PORT=18000
MEM_LIMIT=6g
SHM_SIZE=1gb

VLLM_IMAGE=vllm/vllm-openai:v0.32.0@sha256:befccf0e7e4089aa23926bb6f887a85c0d46c2a99e6de5c5ffdf5cb7957c5b34
